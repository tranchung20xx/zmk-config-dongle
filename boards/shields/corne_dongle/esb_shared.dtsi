/ {
    esb_link {
        compatible = "zmk,split-esb";
        base-address = [E7 D3 9A 5C];
        /* bitrate-kbps = <1000>; */
        use-fast-ramp-up;
        retransmit-delay-us = <1000>;
        retransmit-count = <6>;
        peripheral-timeout-ms = <1000>;
        hop-channels = [28 2C 30 34 38 3C 40 44 48 4C];   // 40 44 48 52 56 60 64 68 72 76
        hop-anchors = [2C 3C 4C];                         // 44 60 76
        hop-min-active = <6>;
        tx-power-dbm = <8>;
        peripherals {
            left: peripheral_left  { pipe = <0>; prefix = <0x4B>; weight = <1>; };
            right: peripheral_right { pipe = <1>; prefix = <0xC3>; weight = <1>; };
        };
    };
};
