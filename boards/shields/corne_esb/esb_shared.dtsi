/ {
    esb_link {
        compatible = "zmk,split-esb";
        base-address = [E7 D3 9A 5C];
        bitrate-kbps = <1000>;
        use-fast-ramp-up;
        retransmit-delay-us = <1000>;
        retransmit-count = <6>;
        hop-channels = [19 28 2C 30 32 34 38 3C 40 44 48 4C];   // adds 25 and 50
        hop-anchors = [19 32 4C];                                // 25, 50, 76
        hop-min-active = <6>;
        tx-power-dbm = <8>;
        peripherals {
            left: peripheral_left  { pipe = <0>; prefix = <0x4B>; weight = <1>; };
            right: peripheral_right { pipe = <1>; prefix = <0xC3>; weight = <1>; };
        };
    };
};
